#!/bin/bash
# 生命周期入口：main start | stop | status
# 骨架阶段以心跳进程代替真实服务，用于验证平台对 start/stop/status 的调用与退出码语义
set -u

APP="niudbm"
VAR="${TRIM_PKGVAR:-/var/apps/$APP/var}"
PIDF="$VAR/heartbeat.pid"
HB="$VAR/heartbeat"
mkdir -p "$VAR" 2>/dev/null

is_running() {
  [ -f "$PIDF" ] || return 1
  local pid
  pid="$(cat "$PIDF" 2>/dev/null)"
  [ -n "$pid" ] || return 1
  kill -0 "$pid" 2>/dev/null
}

start() {
  if is_running; then
    echo "already running (pid=$(cat "$PIDF"))"
    return 0
  fi
  nohup /bin/bash -c 'while :; do date +%s > "$1/heartbeat"; sleep 30; done' \
    niudbm_heartbeat "$VAR" >/dev/null 2>&1 &
  echo $! > "$PIDF"
  date +%s > "$HB"
  echo "started pid=$(cat "$PIDF")"
  return 0
}

stop() {
  if ! is_running; then
    rm -f "$PIDF" 2>/dev/null
    echo "already stopped"
    return 0
  fi
  kill "$(cat "$PIDF")" 2>/dev/null
  sleep 1
  rm -f "$PIDF" 2>/dev/null
  echo "stopped"
  return 0
}

case "${1:-status}" in
  start)  start ;;
  stop)   stop ;;
  status)
    if is_running; then
      echo "running"
      exit 0
    fi
    echo "stopped"
    exit 3   # 平台约定：3 = 未运行
    ;;
  *)
    echo "usage: $0 start|stop|status" >&2
    exit 1
    ;;
esac
