#!/bin/bash
# 生命周期入口：main start | stop | status
# start 时拉起 target/niudbm，监听 target/app.sock，由统一网关转发 /app/niudbm
set -u

APP="niudbm"
VAR="${TRIM_PKGVAR:-/var/apps/$APP/var}"
DEST="${TRIM_APPDEST:-/var/apps/$APP/target}"
BIN="$DEST/niudbm"
SOCK="$DEST/app.sock"
PIDF="$VAR/server.pid"
LOG="$VAR/logs/server.log"

mkdir -p "$VAR/logs" 2>/dev/null

# 平台以 root 拉起脚本；数据目录必须归应用用户，否则服务能起却写不进库。
# 每次启动做一次递归修正，代价远低于“权限不对”的排查成本。
if [ "$(id -u)" -eq 0 ] && [ -n "${TRIM_USERNAME:-}" ] && [ -d "$VAR" ]; then
  chown -R "$TRIM_USERNAME" "$VAR" 2>/dev/null || true
fi

is_running() {
  [ -f "$PIDF" ] || return 1
  local pid
  pid="$(cat "$PIDF" 2>/dev/null)"
  [ -n "$pid" ] || return 1
  kill -0 "$pid" 2>/dev/null
}

# 等到 socket 可连接再返回，避免应用中心刚点完就打开页面出现空窗
wait_ready() {
  local i=0
  while [ "$i" -lt 60 ]; do
    [ -S "$SOCK" ] && return 0
    is_running || return 1
    sleep 0.1
    i=$((i + 1))
  done
  return 1
}

start() {
  if is_running; then
    echo "already running (pid=$(cat "$PIDF"))"
    return 0
  fi
  if [ ! -x "$BIN" ]; then
    echo "找不到可执行文件：$BIN" >&2
    return 1
  fi

  rm -f "$SOCK" "$PIDF" 2>/dev/null
  nohup "$BIN" --socket "$SOCK" >> "$LOG" 2>&1 &
  echo $! > "$PIDF"

  if wait_ready; then
    echo "started pid=$(cat "$PIDF") socket=$SOCK"
    return 0
  fi

  echo "启动失败，最近日志：" >&2
  tail -n 8 "$LOG" >&2 2>/dev/null
  rm -f "$PIDF" 2>/dev/null
  return 1
}

stop() {
  if ! is_running; then
    rm -f "$PIDF" "$SOCK" 2>/dev/null
    echo "already stopped"
    return 0
  fi

  local pid i=0
  pid="$(cat "$PIDF")"
  kill -TERM "$pid" 2>/dev/null

  # 给优雅退出留 5 秒；超时则强制结束，确保不留残留
  while kill -0 "$pid" 2>/dev/null && [ "$i" -lt 50 ]; do
    sleep 0.1
    i=$((i + 1))
  done
  if kill -0 "$pid" 2>/dev/null; then
    kill -KILL "$pid" 2>/dev/null
  fi

  rm -f "$PIDF" "$SOCK" 2>/dev/null
  echo "stopped"
  return 0
}

case "${1:-status}" in
  start) start ;;
  stop)  stop ;;
  status)
    if is_running; then
      echo "running"
      exit 0
    fi
    echo "stopped"
    exit 3   # 平台约定：3 = 未运行
    ;;
  *)
    echo "usage: $0 start|stop|status" >&2
    exit 1
    ;;
esac
