#!/bin/bash
# 升级完成：记录版本并重跑自检，确认升级后环境未退化
set -u

LOG="${TRIM_TEMP_LOGFILE:-/tmp/niudbm_upgrade.log}"
exec >> "$LOG" 2>&1

say() { echo "[$(date '+%F %T')] [upgrade_callback] $*"; }

APP="niudbm"
VAR="${TRIM_PKGVAR:-/var/apps/$APP/var}"
TARGET="${TRIM_APPDEST:-/var/apps/$APP/target}"

printf '%s %s\n' "$(date '+%F %T')" "${TRIM_APPVER:-unknown}" > "$VAR/installed_at"

DIAG="$TARGET/niudbm"
if [ -x "$DIAG" ]; then
  "$DIAG" --diag > "$VAR/diagnose-report.txt" 2>&1 \
    || say "WARN: 诊断报告生成失败"
fi

say "ok -> ${TRIM_APPVER:-unknown}"
exit 0
