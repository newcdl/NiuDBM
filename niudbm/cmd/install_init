#!/bin/bash
# 安装前置检查：环境不满足时中止安装
set -u

LOG="${TRIM_TEMP_LOGFILE:-/tmp/niudbm_install.log}"
exec >> "$LOG" 2>&1

say() { echo "[$(date '+%F %T')] [install_init] $*"; }
die() { say "FAIL: $1"; echo "$1" >&2; exit 1; }

say "start"

ARCH="$(uname -m 2>/dev/null || echo unknown)"
case "$ARCH" in
  x86_64 | aarch64 | arm64) say "arch=$ARCH" ;;
  *) die "不支持的 CPU 架构：$ARCH" ;;
esac

if [ -r /proc/meminfo ]; then
  MEM_MB="$(awk '/MemTotal/ {printf "%d", $2/1024}' /proc/meminfo)"
  if [ "${MEM_MB:-0}" -lt 512 ]; then
    die "内存不足 512MB（当前 ${MEM_MB}MB）"
  fi
  say "mem=${MEM_MB}MB"
fi

# 量可用空间。安装阶段 TRIM_APPDEST 指向的目录往往还没被创建出来，
# 直接 df 一个不存在的路径只会拿到空字符串——拿空值当 0MB 用，会把好机器拦在门外。
disk_free_mb() {
  local p="${1:-/}"
  while [ -n "$p" ] && [ "$p" != "/" ] && [ ! -e "$p" ]; do
    p="$(dirname "$p")"
  done
  [ -e "$p" ] || p="/"
  df -Pk "$p" 2>/dev/null | awk 'NR==2 {printf "%d", $4/1024}'
}

TARGET="${TRIM_APPDEST:-/}"
AVAIL_MB="$(disk_free_mb "$TARGET")"
if [ -z "$AVAIL_MB" ]; then
  # 量不出来就不拦安装：宁可装完在页面里提示，也不能让正常机器装不上
  say "WARN: 无法检测 $TARGET 所在分区的可用空间，跳过空间检查"
elif [ "$AVAIL_MB" -lt 200 ]; then
  die "目标分区可用空间不足 200MB（当前 ${AVAIL_MB}MB）"
else
  say "free=${AVAIL_MB}MB"
fi

say "ok"
exit 0
